{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafos.local/ccis/contracts/task-envelope.v1.schema.json",
  "title": "CCIS Task Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["ccis_object", "schema_version", "task_id", "instruction", "target", "mode", "objective", "scope", "budget", "validators", "authority"],
  "properties": {
    "ccis_object": {"const": "ccis.task_envelope"},
    "schema_version": {"const": 1},
    "task_id": {"$ref": "#/$defs/id"},
    "instruction": {"type": "string", "minLength": 1, "maxLength": 4000},
    "target": {"type": "string", "minLength": 1},
    "mode": {"enum": ["once", "continual"]},
    "created_at": {"type": "string", "format": "date-time"},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "invariants", "tolerances", "stopping_conditions"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "invariants": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}},
        "tolerances": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/tolerance"}},
        "stopping_conditions": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1}}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_revision", "allowed_paths", "denied_paths"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "base_revision": {"type": "string", "minLength": 1},
        "allowed_paths": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "denied_paths": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "wall_time_seconds", "candidate_limit", "revision_limit", "max_iterations", "max_changed_files"],
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "wall_time_seconds": {"type": "integer", "minimum": 1, "maximum": 604800},
        "candidate_limit": {"type": "integer", "minimum": 1, "maximum": 128},
        "revision_limit": {"type": "integer", "minimum": 0, "maximum": 32},
        "max_iterations": {"type": "integer", "minimum": 1, "maximum": 128},
        "max_changed_files": {"type": "integer", "minimum": 1, "maximum": 4096},
        "compute_units": {"type": ["number", "null"], "minimum": 0},
        "notes": {"type": "string", "maxLength": 2000}
      }
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["validator_id", "kind", "required"],
        "properties": {
          "validator_id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["command", "hash", "json_schema", "invariant", "manual"]},
          "required": {"type": "boolean"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "schema_ref": {"type": "string", "minLength": 1},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requester", "decision_actor", "acceptance_mode", "automatic_working_tree_merge", "may_modify", "may_install", "may_merge", "capabilities"],
      "properties": {
        "requester": {"type": "string", "minLength": 1},
        "decision_actor": {"type": "string", "minLength": 1},
        "acceptance_mode": {"const": "explicit_operator"},
        "automatic_working_tree_merge": {"const": false},
        "may_modify": {"type": "boolean"},
        "may_install": {"type": "boolean"},
        "may_merge": {"const": false},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["inspect", "propose", "evaluate", "revise", "stage", "accept", "rollback", "escalate"]}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{2,127}$"},
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "operator", "threshold"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "operator": {"enum": ["eq", "ne", "lt", "lte", "gt", "gte", "within", "contains"]},
        "threshold": {},
        "unit": {"type": ["string", "null"]}
      }
    }
  }
}
