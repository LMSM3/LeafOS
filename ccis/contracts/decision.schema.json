{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafos.local/ccis/contracts/decision.v1.schema.json",
  "title": "CCIS Gate Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["ccis_object", "schema_version", "decision_id", "task_id", "candidate_id", "evaluation_id", "decided_at", "decided_by", "outcome", "reasons", "staging_required", "working_tree_merged", "authority_ref", "next_action"],
  "properties": {
    "ccis_object": {"const": "ccis.decision"},
    "schema_version": {"const": 1},
    "decision_id": {"$ref": "#/$defs/id"},
    "task_id": {"$ref": "#/$defs/id"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "evaluation_id": {"$ref": "#/$defs/id"},
    "decided_at": {"type": "string", "format": "date-time"},
    "decided_by": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["ACCEPTED", "REVISE", "REJECTED", "BLOCKED", "ESCALATED"]},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "staging_required": {"type": "boolean"},
    "working_tree_merged": {"const": false},
    "authority_ref": {"type": "string", "pattern": "^authority://"},
    "evidence_bundle_ref": {"type": "string", "pattern": "^evidence://"},
    "next_action": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "ACCEPTED"}}, "required": ["outcome"]},
      "then": {"properties": {"staging_required": {"const": true}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{2,127}$"}
  }
}
