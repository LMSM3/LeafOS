{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafos.local/schemas/leafos.memory.query.v1.schema.json",
  "title": "LeafOS memory query v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "run_id", "task_id", "query", "kinds", "paths", "time_horizon", "max_items", "max_bytes", "include_superseded", "minimum_epistemic_class"],
  "properties": {
    "schema": { "const": "leafos.memory.query.v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": ["string", "null"] },
    "task_id": { "type": ["string", "null"] },
    "query": { "type": "string", "maxLength": 8192 },
    "kinds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "paths": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "time_horizon": { "enum": ["run", "project", "archive"] },
    "max_items": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "max_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
    "include_superseded": { "type": "boolean" },
    "minimum_epistemic_class": { "enum": ["record", "evidence", "committed_fact"] }
  }
}
