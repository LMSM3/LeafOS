{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafos.local/schemas/leafos.glyph.v1.schema.json",
  "title": "LeafOS Glyph Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "leafos_object",
    "version",
    "alias",
    "glyph",
    "codepoints",
    "category",
    "severity",
    "ascii",
    "meaning",
    "render_mode"
  ],
  "properties": {
    "leafos_object": {"const": "leafos.glyph"},
    "version": {"const": 1},
    "alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*$"
    },
    "glyph": {"type": "string", "minLength": 1},
    "codepoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9A-F]{4,6}$"
      }
    },
    "category": {
      "enum": [
        "identity",
        "growth",
        "flower",
        "flow",
        "model",
        "verify",
        "status",
        "loading",
        "io",
        "data",
        "cosmetic"
      ]
    },
    "severity": {"enum": ["none", "info", "ok", "warn", "error"]},
    "ascii": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[ -~]+$"
    },
    "meaning": {"type": "string", "minLength": 1},
    "render_mode": {"enum": ["unicode", "ascii"]}
  }
}
