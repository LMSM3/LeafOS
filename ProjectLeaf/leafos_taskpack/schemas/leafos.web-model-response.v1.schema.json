{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafos.local/schemas/leafos.web-model-response.v1.schema.json",
  "title": "LeafOS Web Model Pipe Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "ok", "authority"],
  "properties": {
    "schema": {"const": "leafos.web-model.response.v1"},
    "request_id": {"type": "string"},
    "ok": {"type": "boolean"},
    "authority": {"enum": ["proposal-only", "none"]},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "content": {"type": "string"},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  },
  "oneOf": [
    {
      "properties": {"ok": {"const": true}, "authority": {"const": "proposal-only"}},
      "required": ["provider", "model", "content", "usage"],
      "not": {"required": ["error"]}
    },
    {
      "properties": {"ok": {"const": false}, "authority": {"const": "none"}},
      "required": ["error"],
      "not": {"anyOf": [{"required": ["content"]}, {"required": ["usage"]}]}
    }
  ]
}
