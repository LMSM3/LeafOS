{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leafos.agent-loop-plan.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["leafos_object", "version", "task_id", "steps"],
  "properties": {
    "leafos_object": {"const": "agent_loop_plan"},
    "version": {"const": 2},
    "task_id": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["read_files", "apply_patch", "write_file", "run_command", "run_tests", "record_hashes", "checkpoint", "report"]},
          "paths": {"type": "array", "items": {"type": "string"}},
          "path": {"type": "string"},
          "content": {"type": "string"},
          "patch": {"type": "string"},
          "patch_file": {"type": "string"},
          "command": {"type": "array", "items": {"type": "string"}},
          "cwd": {"type": "string"},
          "timeout_seconds": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
