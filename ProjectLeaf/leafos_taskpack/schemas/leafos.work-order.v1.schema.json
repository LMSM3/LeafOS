{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leafos.work-order.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["work_order_id", "title", "target", "objective", "allowed_paths", "commands", "acceptance"],
  "properties": {
    "work_order_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "denied_paths": {"type": "array", "items": {"type": "string"}},
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "approval_mode": {"enum": ["required", "automatic"]},
    "allow_mutation": {"type": "boolean", "default": false},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
  }
}
