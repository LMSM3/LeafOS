{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafos.local/schemas/leafos.midend-capability.v1.schema.json",
  "title": "LeafOS Midend Capability Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["leafos_object", "version", "capability_id", "target_types", "payload_schema_ref", "approval_policy", "native_handler", "side_effect_class", "evidence_requirements"],
  "properties": {
    "leafos_object": {"const": "leafos.midend_capability"},
    "version": {"const": 1},
    "capability_id": {"enum": ["project.create", "project.open", "run.start", "run.pause", "run.resume", "run.cancel", "task.approve", "task.reject", "task.retry", "profile.activate", "install.plan", "install.apply", "install.rollback", "report.export"]},
    "target_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["host", "workspace", "project", "run", "task", "profile", "install_plan", "report"]}},
    "payload_schema_ref": {"type": "string", "pattern": "^schema://capabilities/"},
    "preconditions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
    "approval_policy": {"enum": ["none", "session", "explicit", "explicit_digest_bound", "policy_bound"]},
    "native_handler": {"type": "string", "pattern": "^leaf\\.inlet\\.[a-z0-9._-]+\\.v1$"},
    "side_effect_class": {"enum": ["read_only", "project_mutation", "run_control", "host_mutation", "artifact_export"]},
    "evidence_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["control_receipt", "validation_report", "checkpoint", "artifact_hash", "native_disposition"]}}
  }
}
