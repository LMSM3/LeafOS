  $PROJECT_CLI runtime select [--main KEY] [--coder KEY] [--language LANG] [--coding-model KEY] [--coding-tier TIER] [--persona KEY] [--mode MODE] [--json]
  $PROJECT_CLI runtime personas [--json]
  $PROJECT_CLI runtime models [--json]
  $PROJECT_CLI runtime workers CONFIDENCE [REASON...] [--json]
