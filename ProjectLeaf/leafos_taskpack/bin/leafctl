  $PROJECT_CLI web-state [--json] [--refresh-metadata] [--write]
  $PROJECT_CLI fullstackbench [--json] [--write] [--generated-tokens N]
  $PROJECT_CLI realbench conversation [--duration 60]
  $PROJECT_CLI realbench raw [--target 66]
  $PROJECT_CLI realbench matrix --manifest FILE [--resume] [--dry-run]
  $PROJECT_CLI realbench summary --report FILE [--output-usd-per-million N]
  $PROJECT_CLI telemetry universal-sample RUN_DIR [--run-kind KIND] [--json]
  $PROJECT_CLI telemetry universal-summary RUN_DIR_OR_LOG
  $PROJECT_CLI agent-loop-start --target DIR --work-order FILE --profile local-coding --yes
  $PROJECT_CLI agent-loop-start --target DIR --projects generic-python-sim --profile repository --yes  # legacy templates
  $PROJECT_CLI agent-loop-status RUN_DIR_OR_TARGET [--json]
  $PROJECT_CLI agent-loop-tick RUN_DIR_OR_TARGET
  $PROJECT_CLI agent-loop-resume RUN_DIR_OR_TARGET
  $PROJECT_CLI agent-loop-stop RUN_DIR_OR_TARGET [--after-current-step]
  $PROJECT_CLI agent-loop-report RUN_DIR_OR_TARGET [--json]
  $PROJECT_CLI loop start DIR --work-order FILE [--profile local-coding] [--yes]
  $PROJECT_CLI loop start DIR [--provider required|auto|off] [--foreground|--create-only] --check COMMAND [ARGS...]
  $PROJECT_CLI loop attach [RUN|active] [--after SEQ] [--json]
  $PROJECT_CLI loop monitor [RUN|active] [--interactive|--noninteractive] [--json|--jsonl] [--once]
  $PROJECT_CLI loop pause|resume|stop|drain|status|report [RUN|active] [--json]
  $PROJECT_CLI loop task submit RUN REQUEST.json
  $PROJECT_CLI loop task prioritize|retry|cancel|approve RUN TASK_ID [PRIORITY]
  $PROJECT_CLI transport usb init ROOT [--identity ID] [--json]
  $PROJECT_CLI transport usb status ROOT [--json]
  $PROJECT_CLI transport usb pump ROOT [--once] [--interval SECONDS] [--json]
  $PROJECT_CLI transport usb publish ROOT --payload FILE --type TYPE --target-run RUN [--json]
  $PROJECT_CLI passive-report [-RunRoot RUN] [-Open] [-Json]
  $PROJECT_CLI passive-report -StartProject -Project DIR [-BudgetMinutes N] [-Provider off|auto|required]
  $PROJECT_CLI sandbox-create --target DIR --projects chess3D,generic-python-sim --yes
  $PROJECT_CLI sandbox-run RUN_DIR_OR_TARGET
  $PROJECT_CLI continual-live start [--config PATH]
  $PROJECT_CLI continual-live status [--run-dir PATH]
