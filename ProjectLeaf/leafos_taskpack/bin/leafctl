#!/usr/bin/env bash
set -euo pipefail

if [[ "${BASH_VERSINFO[0]:-0}" -lt 4 ]]; then
    echo "leafctl: bash 4.0+ required (found ${BASH_VERSION:-unknown})" >&2
    exit 1
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/core/brand/brand.sh"
source "$ROOT_DIR/core/log/log.sh"
source "$ROOT_DIR/core/loaders/loaders.sh"
source "$ROOT_DIR/core/glyphs/glyphs.sh"
source "$ROOT_DIR/core/runtime/runtime.sh"
source "$ROOT_DIR/core/agent/agent.sh"
source "$ROOT_DIR/core/system/platform.sh"
source "$ROOT_DIR/core/system/versions.sh"
# providers.sh is sourced transitively via agent.sh
source "$ROOT_DIR/core/graph/graph.sh"
source "$ROOT_DIR/core/agent/wait.sh"
source "$ROOT_DIR/core/agent/actions.sh"
source "$ROOT_DIR/core/agent/repair.sh"
