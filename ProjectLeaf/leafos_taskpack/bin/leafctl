  $PROJECT_CLI accelerator status|test|fallback cpu [--json]
  $PROJECT_CLI provider-stack check|start|status|stop [--json]
  $PROJECT_CLI hf bootstrap|auth|whoami|get|verify ...
  $PROJECT_CLI stack inspect|validate|install|activate STACK [--dry-run]
  $PROJECT_CLI oneshot --oneshot SOURCE TARGET [--force|--dry-run|--no-zip]
  $PROJECT_CLI wakeup [--force heads|tails] [--ticker SYMBOL] [--no-log]
