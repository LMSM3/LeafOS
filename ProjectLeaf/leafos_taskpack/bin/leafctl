source "$ROOT_DIR/core/orchestration/orchestrate.sh"

leaf_require_capability() {
    local capability="$1"
    local actor="${2:-leafctl}"
    local reason="${3:-CLI mutation pre-flight}"
    local py="${LEAFCTL_PYTHON}"
    [[ -n "$py" ]] || brand_die "python3 not found (capability enforcement requires Python)"
    if ! "$py" "$ROOT_DIR/core/python/leaf_authority.py" require \
            "$capability" --actor "$actor" --reason "$reason" --json >/dev/null 2>&1; then
        brand_die "capability denied: $capability (actor=$actor). See 'leafctl bloom capability --actor <actor> ${capability}' to record an explicit request."
    fi
}

leafctl_ensure_python() {
    # Prefer caller-provided Python, then PATH, then a small set of known
    # native Windows/MSYS locations.  This avoids silent set -e termination
    # when PATH does not expose a `python` binary.
    if [[ -n "${LEAFCTL_PYTHON:-}" && -x "${LEAFCTL_PYTHON}" ]]; then
        echo "$LEAFCTL_PYTHON"
        return 0
    fi
    local candidate
    for candidate in "$(command -v python3 2>/dev/null || true)" \
                     "$(command -v python 2>/dev/null || true)" \
                     /c/msys64/ucrt64/bin/python.exe \
                     /c/Python313/python.exe \
                     /c/Python312/python.exe \
                     /c/Python311/python.exe \
                     "${USERPROFILE:-}/AppData/Local/Programs/Python/Python313/python.exe" \
                     "${USERPROFILE:-}/AppData/Local/Programs/Python/Python312/python.exe" \
                     "${USERPROFILE:-}/AppData/Local/Programs/Python/Python311/python.exe"; do
        if [[ -n "$candidate" && -x "$candidate" ]]; then
            echo "$candidate"
            return 0
        fi
    done
    brand_die "python3 not found; set LEAFCTL_PYTHON to a Python 3.10+ executable"
}

LEAFCTL_PYTHON="$(leafctl_ensure_python)"
export LEAFCTL_PYTHON

cmd="${1:-home}"
shift || true

case "$cmd" in
    q)   cmd="quick" ;;
    h)   cmd="home" ;;
    s)   cmd="status" ;;
    d)   cmd="doctor" ;;
    r)   cmd="runtime"; set -- select "$@" ;;
    p)   cmd="provider-stack"; set -- check "$@" ;;
    t)   cmd="trace"; set -- latest "$@" ;;
    ref) cmd="reference" ;;
    b)   cmd="bloom"; set -- status "$@" ;;
    m)   cmd="flower-monitor" ;;
    c)   cmd="chat" ;;
    go)  cmd="live" ;;
    vtop) cmd="vtop" ;;
    identity) cmd="pack-identity"; set -- generate "$@" ;;
esac

leaf_powershell_forward() {
    leaf_detect_pwsh
    local requested_command="${1:-command}"
    if ! leaf_pwsh_meets 7.0; then
        if [[ -n "${LEAF_PWSH_CMD:-}" ]]; then
            brand_die "PowerShell 7+ is required for '$requested_command'; found ${LEAF_VER_PWSH:-unknown} at ${LEAF_PWSH_CMD}. The PowerShell 5/5.1 fallback is limited to compatible features such as 'indicator'."
        fi
        brand_die "PowerShell 7+ is required for '$requested_command'; install PowerShell 7 or repair PATH, then retry."
    fi

    local ps_script="$ROOT_DIR/bin/leafctl.ps1"
    local -a ps_args=("$@")
    local caller_shell="bash"
    if leaf_is_wsl; then
        caller_shell="wsl"
    fi
    if [[ "$LEAF_PWSH_CMD" == *.exe ]] && command -v wslpath &>/dev/null; then
        ps_script="$(wslpath -w "$ps_script")"
        local i
        for i in "${!ps_args[@]}"; do
            if [[ "${ps_args[$i]}" == /mnt/* ]]; then
                ps_args[$i]="$(wslpath -w "${ps_args[$i]}")"
            fi
        done
    fi

    if [[ "$caller_shell" == "wsl" && "$LEAF_PWSH_CMD" == *.exe ]]; then
        local interop_env="${WSLENV:-}"
        if [[ ":$interop_env:" != *":LEAF_CALLER_SHELL:"* ]]; then
            interop_env="${interop_env:+$interop_env:}LEAF_CALLER_SHELL"
        fi
        WSLENV="$interop_env" LEAF_CALLER_SHELL="$caller_shell" \
            "$LEAF_PWSH_CMD" -NoProfile -File "$ps_script" "${ps_args[@]}"
    else
        LEAF_CALLER_SHELL="$caller_shell" \
            "$LEAF_PWSH_CMD" -NoProfile -File "$ps_script" "${ps_args[@]}"
    fi
}

leaf_is_wsl() {
    [[ -n "${WSL_DISTRO_NAME:-}" ]] || [[ "$(uname -r 2>/dev/null || true)" == *[Mm]icrosoft* ]]
}

