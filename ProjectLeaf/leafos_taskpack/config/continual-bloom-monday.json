    "mutate project files directly",
    "promote a claim without native evidence",
    "declare validation or checkpoint success",
    "accept a proposal generated from a stale transcript head"
  ],
  "routing_preferences": {
    "main_model_persona": true,
    "coder_persona_neutral": true,
    "preferred_lane": "cpu",
    "cloud_fallback": false
  },
  "durability": {
    "event_log": "events.ndjson",
    "fact_log": "facts.ndjson",
    "state": "state.json",
    "kv_cache_authoritative": false,
    "hash_algorithm": "sha256"
  },
  "planner_fields": [
    "observations",
    "constraints",
    "hypotheses",
    "objections",
    "evidence_refs",
    "confidence",
    "proposed_next_action"
  ]
}
