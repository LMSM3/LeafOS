root ::= object
value ::= object | array | string | number | boolean | null
object ::= "{" ws (string ws ":" ws value ("," ws string ws ":" ws value)*)? ws "}"
array ::= "[" ws (value ("," ws value)*)? ws "]"
string ::= "\"" ( [^"\\] | "\\" escape )* "\""
escape ::= ["\\/bfnrt] | "u" hex hex hex hex
number ::= "-"? ([0-9] | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [-+]? [0-9]+)?
boolean ::= "true" | "false"
null ::= "null"
hex ::= [0-9a-fA-F]
ws ::= [ \t\n]*
