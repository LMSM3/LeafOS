{
  "schema": "leafos.fast-three-stack-overnight.v1",
  "run_id": "fast-three-stack-overnight",
  "source_sandbox": "sandbox/overnight-01/work",
  "output_root": "sandbox/fast-three-stack-overnight",
  "stop_on_failure": true,
  "modules": [
    {
      "id": "game-chess",
      "relative_path": "game-chess",
      "configure_command": ["cmake", "-S", ".", "-B", "build"],
